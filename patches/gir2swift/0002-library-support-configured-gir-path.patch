From b315c4bc51c1051ecc69ec814dbab0e482d8d080 Mon Sep 17 00:00:00 2001
From: awesoMux Linux <noreply@awesomux.local>
Date: Fri, 28 Aug 2026 00:00:00 -0400
Subject: [PATCH] library: support a configured GIR search path

Use the same hermetic GIR directory contract when the generator resolves the
primary manifest input.
---
 Sources/libgir2swift/utilities/planning.swift | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/Sources/libgir2swift/utilities/planning.swift b/Sources/libgir2swift/utilities/planning.swift
index 075002b..a98c83f 100644
--- a/Sources/libgir2swift/utilities/planning.swift
+++ b/Sources/libgir2swift/utilities/planning.swift
@@ -157 +157,5 @@ extension Plan {
-        let defaultPaths = ["/opt/homebrew/share/gir-1.0", "/usr/local/share/gir-1.0", "/usr/share/gir-1.0"].map { URL(fileURLWithPath: $0, isDirectory: false) }
+        let configuredPaths = ProcessInfo.processInfo.environment["GIR2SWIFT_GIR_PATH"]?
+            .split(separator: ":")
+            .map(String.init) ?? []
+        let defaultPaths = (configuredPaths + ["/opt/homebrew/share/gir-1.0", "/usr/local/share/gir-1.0", "/usr/share/gir-1.0"])
+            .map { URL(fileURLWithPath: $0, isDirectory: false) }
--
