diff --git a/src/apprt/embedded.zig b/src/apprt/embedded.zig
--- a/src/apprt/embedded.zig
+++ b/src/apprt/embedded.zig
@@ -1841,6 +1841,33 @@
         ptr.app.closeSurface(ptr);
     }

+    export fn ghostty_surface_free_display_lost(ptr: *Surface) void {
+        if (comptime builtin.target.os.tag == .linux) {
+            ptr.core_surface.display_lost = true;
+            ptr.app.closeSurface(ptr);
+        }
+    }
+
+    /// Preserve terminal I/O and scrollback while a Linux host replaces the
+    /// GL context (for example, when GTK reparents a split pane).
+    export fn ghostty_surface_display_unrealized(surface: *Surface) void {
+        if (comptime builtin.target.os.tag == .linux) {
+            surface.core_surface.renderer.displayUnrealized();
+        }
+    }
+
+    /// Rebuild only GPU state after the host has made its new context current.
+    export fn ghostty_surface_display_realized(surface: *Surface) bool {
+        if (comptime builtin.target.os.tag == .linux) {
+            surface.core_surface.renderer.displayRealized() catch |err| {
+                log.err("error restoring surface display err={}", .{err});
+                return false;
+            };
+            return true;
+        }
+        return false;
+    }
+
     /// Returns the userdata associated with the surface.
     export fn ghostty_surface_userdata(surface: *Surface) ?*anyopaque {
         return surface.userdata;
