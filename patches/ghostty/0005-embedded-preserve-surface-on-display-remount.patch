diff --git a/src/renderer/opengl/shaders.zig b/src/renderer/opengl/shaders.zig
index 68d2babf6..db7649543 100644
--- a/src/renderer/opengl/shaders.zig
+++ b/src/renderer/opengl/shaders.zig
@@ -151,6 +151,14 @@ pub const Shaders = struct {
             alloc.free(self.post_pipelines);
         }
     }
+
+    /// The context is gone: free owned CPU slices without issuing GL calls.
+    pub fn abandon(self: *Shaders, alloc: Allocator) void {
+        if (self.defunct) return;
+        self.defunct = true;
+        if (self.post_pipelines.len > 0) alloc.free(self.post_pipelines);
+        self.post_pipelines = &.{};
+    }
 };
