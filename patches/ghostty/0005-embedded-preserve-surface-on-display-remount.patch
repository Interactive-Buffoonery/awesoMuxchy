diff --git a/src/renderer/generic.zig b/src/renderer/generic.zig
--- a/src/renderer/generic.zig
+++ b/src/renderer/generic.zig
@@ -834,6 +834,24 @@ pub fn Renderer(comptime GraphicsAPI: type) type {
             self.* = undefined;
         }
-
+
+        /// Final teardown only, after both worker threads have joined and
+        /// the OpenGL context has become unusable. Retain no CPU allocations,
+        /// and allow normal deinit to release terminal/font/PTY state.
+        pub fn abandonOpenGLResources(self: *Self) void {
+            comptime assert(GraphicsAPI == @import("OpenGL.zig"));
+            self.draw_mutex.lockUncancelable(global.io());
+            defer self.draw_mutex.unlock(global.io());
+            // SwapChain frames and postprocessing targets contain only GL
+            // handles. The context driver reclaims them; never call deinit.
+            self.swap_chain = null;
+            self.shaders.abandon(self.alloc);
+            self.images.abandonOpenGL(self.alloc);
+            if (self.bg_image) |img| img.abandonOpenGL(self.alloc);
+            self.bg_image = null;
+            self.api.last_target = null;
+            self.display_realized = false;
+        }
+
         fn deinitShaders(self: *Self) void {
             self.shaders.deinit(self.alloc);
         }
@@ -949,6 +949,9 @@
-
+
             // We reinitialize our shaders and our swap chain.
             try self.initShaders();
+            // Swap-chain creation can still fail after shaders were allocated.
+            // Keep the renderer safely retryable and its later deinit idempotent.
+            errdefer self.shaders.deinit(self.alloc);
             self.swap_chain = try SwapChain.init(
                 self.api,
                 self.has_custom_shaders,

