+    /// Drop CPU-owned image data after OpenGL loss; the driver owns the dead
+    /// texture handles and they must not be deleted under another context.
+    pub fn abandonOpenGL(self: *State, alloc: Allocator) void {
+        var it = self.images.iterator();
+        while (it.next()) |kv| kv.value_ptr.image.abandonOpenGL(alloc);
+        self.images.deinit(alloc);
+        self.kitty_placements.deinit(alloc);
+        self.overlay_placements.deinit(alloc);
+        self.* = .empty;
+    }
+
     /// Upload any images to the GPU that need to be uploaded,
